# Copy to .env and fill in
PORT=3000
BASE_URL=http://localhost:3000
SITE_NAME=Courtside Social Club
SITE_TAGLINE=Find and join social events near you. Book your spot, see who's coming, and meet the crew.
JWT_SECRET=change-this-to-a-long-random-string
# Admins: put YOUR email here (comma separated for several). On your computer the first person to sign up
# is also made admin; on a live site ONLY these emails can be admins.
ADMIN_EMAILS=tanyeowhooi1998@gmail.com,tanjunda8680@gmail.com
CURRENCY=aud
# Timezone used for dates in emails
EVENT_TIMEZONE=Australia/Melbourne

# Leave blank to run in TEST MODE (payments simulated). Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customers can cancel a paid booking for an automatic full refund until this many hours before the event.
# Set to 0 to allow it right up to the start time.
REFUND_CUTOFF_HOURS=24

# Email (confirmations, refunds, password reset). RECOMMENDED: Resend (resend.com). It uses a web API, so it
# works on every host. With nothing set, emails are just printed in the server log instead of being sent.
RESEND_API_KEY=
# Alternative to Resend: any SMTP provider. (Many hosts block SMTP, so Resend is the safer choice.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Courtside Social Club <no-reply@yourdomain.com>"

# Where the SQLite file lives (point at a persistent disk when hosting)
DB_PATH=./data.db
